{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "AI Live Translator",
  "version": "0.1.0",
  "identifier": "com.ailivetranslator.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI Live Translator & Smart Answer Assistant",
        "label": "main",
        "width": 960,
        "height": 680,
        "resizable": true,
        "decorations": true,
        "center": true
      },
      {
        "title": "Live Subtitles Overlay",
        "label": "overlay",
        "url": "index.html#overlay",
        "width": 780,
        "height": 180,
        "x": 300,
        "y": 800,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
